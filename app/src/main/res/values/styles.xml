<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style for input fields -->
    <style name="CustomInputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_green</item>
        <item name="hintTextColor">@color/text_dark_grey</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Style for green button -->
    <style name="CustomPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/brand_green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/nunito</item>
    </style>
</resources>
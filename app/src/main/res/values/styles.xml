<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ===== Text: one type scale for every screen (sizes live in dimens.xml) ===== -->

    <!-- Tab screen titles ("My Lists", "Profile") and the splash app name -->
    <style name="Text.App.Display" parent="">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <!-- Extra-heavy weight only exists on Android 9+; older devices just use bold -->
        <item name="android:textFontWeight" tools:targetApi="28">900</item>
        <item name="android:textColor">@color/text_black</item>
    </style>

    <!-- Main heading inside a screen ("Welcome back!", "New List") -->
    <style name="Text.App.Headline" parent="">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
    </style>

    <!-- Smaller headings (empty state message, user name) -->
    <style name="Text.App.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
    </style>

    <!-- Title next to the back arrow -->
    <style name="Text.App.TopBar" parent="">
        <item name="android:textSize">@dimen/text_top_bar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
    </style>

    <!-- Card titles (a list's name on My Lists) -->
    <style name="Text.App.Subtitle" parent="">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
    </style>

    <!-- Subtitles and regular text -->
    <style name="Text.App.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_dark_grey</item>
    </style>

    <style name="Text.App.BodySmall" parent="">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_dark_grey</item>
    </style>

    <!-- Label above an input field -->
    <style name="Text.App.Label" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark_grey</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Fine print (terms, hints) -->
    <style name="Text.App.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_dark_grey</item>
    </style>

    <!-- Green clickable text ("Sign up", "Forgot password?") -->
    <style name="Text.App.Link" parent="Text.App.BodySmall">
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Input field (the Login screen look) ===== -->
    <style name="Widget.App.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius</item>
        <item name="boxStrokeColor">@color/brand_green</item>
        <!-- The label sits above the field, so the hint stays inside as a placeholder instead of floating into the outline -->
        <item name="hintEnabled">false</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- ===== Buttons (the Login screen look) ===== -->

    <!-- Filled green: the main action of a screen -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="backgroundTint">@color/brand_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Green outline: a secondary action ("Create Account" on Welcome) -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="strokeColor">@color/brand_green</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Grey outline: a neutral action ("Continue with Google", "Log Out") -->
    <style name="Widget.App.Button.Outlined.Neutral">
        <item name="strokeColor">@color/outline_grey</item>
        <item name="android:textColor">@color/text_dark_grey</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <!-- No background: dismissive action ("Cancel") -->
    <style name="Widget.App.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="rippleColor">@color/brand_green_ripple</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== Other ===== -->

    <!-- Circular shape for avatars -->
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Row inside the profile settings card -->
    <style name="ProfileMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
        <item name="drawableTint">@color/text_dark_grey</item>
    </style>

    <style name="ProfileMenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:background">@color/divider_grey</item>
    </style>
</resources>

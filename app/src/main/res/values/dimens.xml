<?xml version="1.0" encoding="utf-8"?>
<!-- Base sizes for compact phones; wider phones override them in values-w360dp, taller ones in values-h640dp/values-h780dp -->
<resources>
    <!-- Horizontal gap between the screen edge and the content -->
    <dimen name="screen_padding_horizontal">16dp</dimen>
    <!-- The back arrow has 12dp of built-in padding, so its glyph lines up with the content -->
    <dimen name="top_bar_padding_start">4dp</dimen>

    <!-- Type scale -->
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_top_bar">18sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_body_small">14sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_button">16sp</dimen>

    <!-- Controls -->
    <dimen name="button_height">56dp</dimen>
    <dimen name="corner_radius">12dp</dimen>

    <!-- Hero illustration on Splash, Welcome, empty My Lists and Create New List;
         grows on taller phones (values-h640dp, values-h780dp) -->
    <dimen name="illustration_size">110dp</dimen>
    <!-- Gap between blocks of a screen (heading → field, illustration → heading) -->
    <dimen name="section_spacing">20dp</dimen>
</resources>

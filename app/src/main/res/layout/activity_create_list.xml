<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".CreateListActivity">

    <!-- Top bar: back arrow + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back_create_list"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/action_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/title_create_new_list"
            android:textColor="@color/text_black"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Illustration, title and name field -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:importantForAccessibility="no"
                android:src="@drawable/img_create_list" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/dialog_title_new_list"
                android:textColor="@color/text_black"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/create_list_subtitle"
                android:textColor="@color/text_dark_grey"
                android:textSize="17sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_list_name"
                style="@style/CustomInputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/input_stroke_soft"
                app:boxStrokeWidth="1dp"
                app:errorEnabled="true"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lists"
                app:startIconTint="@color/text_dark_grey">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_list_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_list_name"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:minHeight="60dp"
                    android:textColor="@color/text_black"
                    android:textColorHint="@color/button_cancel_grey"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom actions: Cancel + Create -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_create_list"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/action_cancel"
            android:letterSpacing="0"
            android:textAllCaps="false"
            android:textColor="@color/brand_green"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:rippleColor="@color/brand_green_ripple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_list_confirm"
            style="@style/CustomPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:text="@string/action_create"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One card on My Lists: icon, name, "N items · Updated …", purchased progress -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_grey"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/iv_list_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_list_icon"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/ic_lists"
            app:tint="@color/brand_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_list_name"
                style="@style/Text.App.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Weekly Groceries" />

            <TextView
                android:id="@+id/tv_list_meta"
                style="@style/Text.App.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="12 items · Updated 2 hours ago" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_purchased"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:indicatorColor="@color/brand_green"
                    app:trackColor="@color/divider_grey"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tv_list_progress"
                    style="@style/Text.App.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    tools:text="8 / 12" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_list_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/list_actions"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_black" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

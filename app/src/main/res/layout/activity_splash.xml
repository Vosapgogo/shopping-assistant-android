<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Central Part -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal">

        <ImageView
            android:id="@+id/splash_image"
            android:layout_width="@dimen/illustration_size"
            android:layout_height="@dimen/illustration_size"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@drawable/img_empty_lists" />

        <TextView
            style="@style/Text.App.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/splash_title"
            android:textColor="@color/brand_green" />

        <TextView
            style="@style/Text.App.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/splash_subtitle" />
    </LinearLayout>

    <ProgressBar
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:indeterminateTint="@color/brand_green" />

</RelativeLayout>

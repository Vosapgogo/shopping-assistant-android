<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"> <!-- Твій теплий білий фон -->

    <!-- Central Part -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Image -->
        <ImageView
            android:id="@+id/splash_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/img_empty_lists"
            android:contentDescription="@null" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:text="AI Shopping\nAssistant"
            android:textAlignment="center"
            android:textColor="#2E7D32"
            android:textSize="32sp"
            android:textFontWeight="900"
            android:layout_marginBottom="16dp" />

        <!-- Subtext -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:text="Your smart way to plan\nand save"
            android:textAlignment="center"
            android:textColor="#4A4A4A"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ProgressBar in the bottom -->
    <ProgressBar
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="80dp"
        android:indeterminateTint="#2E7D32" /> <!-- Темно-зелений колір -->

</RelativeLayout>